<?xml version="1.0" encoding="UTF-8"?>
<config>
  <append xpath="/buffs">
    <buff name="doomBuffInLevel" hidden="true">
      <stack_type value="replace" />
      <effect_group>
        <passive_effect name="DisableItem" operation="base_set" value="1" tags="doomnote" />
        <passive_effect name="JumpStrength" operation="perc_set" value=".5" />
        <passive_effect name="RunSpeed" operation="perc_add" value=".4">
			<requirement name="!HasBuff" buff="doomBuffTeleport"/>
		</passive_effect>
        <passive_effect name="WalkSpeed" operation="perc_add" value=".75">
			<requirement name="!HasBuff" buff="doomBuffTeleport"/>
		</passive_effect>
        <passive_effect name="PlayerExpGain" operation="perc_set" value=".5" />
      </effect_group>
    </buff>
    <buff name="buffBlueKeyHeld" name_key="doomKeyBlue" icon="DoomBlueKeycard" remove_on_death="true">
      <stack_type value="ignore" />
      <duration value="0" />
      <display_value_key value="doomKeyBlue" />
      <display_value value="xxx" />
    </buff>
    <buff name="buffRedKeyHeld" name_key="doomKeyRed" icon="DoomRedKeycard" remove_on_death="true">
      <stack_type value="ignore" />
      <duration value="0" />
