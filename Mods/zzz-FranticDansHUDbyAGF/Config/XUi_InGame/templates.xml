<configs>

<!-- Doom-specific: weather equipment not removable -->
<set xpath="//templates/equipment_weather_stack/rect[@allow_remove_item='true']/@allow_remove_item">false</set>

<!-- v3 item_stackAGF (from current BackpackPlus / HUDPlus) — cell_size driven -->
<append xpath="/templates">
	<item_stackAGF controller="ItemStack" on_scroll="false" allow_dropping="true" prefix_id="false" show_favorites="false" cell_size="[itemStack:width]">
		<rect controller="${controller}" style="itemStack, hover" width="${cell_size}" height="${cell_size}" on_scroll="${on_scroll}" allow_dropping="${allow_dropping}" prefix_id="${prefix_id}" show_favorites="${show_favorites}" tooltip="{tooltip}" enabled="{# !defined('userlockmode') or !userlockmode}" visible="{# !defined('container_slots') or (int(${repeat_i}) &lt; int(container_slots)) }">
			<sprite depth="2" name="backgroundMain" sprite="menu_empty3px" pos="-3,3" color="[black]" type="sliced" fillcenter="false" width="${3+cell_size}" height="${3+cell_size}"/>
			<sprite depth="3" name="background" sprite="menu_empty3px" color="{selectionbordercolor}" type="sliced" fillcenter="false" width="${-2+cell_size}" height="${-2+cell_size}"/>
			<sprite depth="2" name="highlightOverlay" color="{backgroundcolor}" pos="0,0" type="sliced" width="${-3+cell_size}" height="${-3+cell_size}"/>
			<texture depth="3" name="backgroundTexture" material="Materials/Transparent Colored" size="${-2+cell_size},${-2+cell_size}"/>
			<sprite depth="8" name="favoriteIcon" width="24" height="24" sprite="server_favorite" pos="2,-2" foregroundlayer="true" visible="{isfavorite}"/>
			<sprite depth="7" name="itemIcon" width="${-11+cell_size}" height="${-11+cell_size}" atlas="ItemIconAtlas" sprite="{itemicon}" pivot="center" foregroundlayer="true" color="{iconcolor}" pos="${Floor(cell_size/2)},${-Floor(cell_size/2)}"/>
			<sprite depth="8" name="lockTypeIcon" width="24" height="24" sprite="{locktypeicon}" pos="2,-2" foregroundlayer="true"/>
			<sprite depth="8" name="itemtypeicon" width="24" height="24" sprite="ui_game_symbol_{itemtypeicon}" pos="2,-2" foregroundlayer="true" visible="{hasitemtypeicon}" color="{itemtypeicontint}"/>
			<sprite depth="2" name="durabilityBackground" sprite="menu_empty3px" color="185,0,0,255" type="sliced" globalopacitymod="0" visible="{haspermadurability}" width="${-5+cell_size}" height="10" pos="1,${-Floor(4*cell_size/5)}"/>
			<sprite depth="4" name="durability" sprite="menu_empty2px" color="[darkGrey]" fill="{removeddurabilityfill}" type="filled" fillspritepad="true" globalopacitymod="0" visible="{hasdurability}" width="${-5+cell_size}" height="10" pos="1,${-Floor(4*cell_size/5)}"/>
			<filledsprite depth="5" name="durability" sprite="menu_empty2px" color="{durabilitycolor}" fill="{durabilityfill}" type="filled" globalopacitymod="0" visible="{hasdurability}" width="${-5+cell_size}" height="10" pos="1,${-Floor(4*cell_size/5)}"/>
			<label depth="8" name="stackValue" height="28" text="{itemcount}" font_size="26" effect="outline" justify="{#hasdurability ? 'Center' : 'Right'}" pos="-2,${-Floor(3*cell_size/5)}" width="${-5+cell_size}"/>
			<label depth="8" name="timer" height="24" font_size="24" justify="center" pivot="center" color="[beige]" effect="outline" pos="${Floor(cell_size/2)},${-Floor(cell_size/2)}" width="${-5+cell_size}" effect_distance="1,1" effect_color="0,0,0,255"/>
			<sprite depth="9" name="cancel" sprite="ui_game_symbol_x" color="255,0,0,255" type="sliced" visible="{# ishovered and islocked}" foregroundlayer="true" width="${-5+cell_size}" height="${-5+cell_size}"/>
			<sprite depth="13" name="assembleIcon" sprite="{stacklockicon}" color="{stacklockcolor}" visible="{isassemblelocked}" pos="14,-14" foregroundlayer="true" size="${-35+cell_size},${-35+cell_size}"/>
			<sprite depth="14" name="quickswapIcon" size="30,30" sprite="server_refresh" pos="40,-2" foregroundlayer="true" visible="{isQuickSwap}"/>
			<button name="rectSlotLock" depth="15" style="press, hover" width="${-2+cell_size}" height="${-2+cell_size}" visible="{# defined('userlockmode') and userlockmode}" sprite="" hoverscale="1" use_selection_box="true">
				<sprite name="slotLockOverlayFill" width="${-3+cell_size}" height="${-3+cell_size}" sprite="menu_empty3px" type="sliced" fillcenter="true" color="{# userlockedslot ? '255,0,0,150' : '0,255,0,150' }"/>
				<sprite name="slotLockOverlayBorder" width="${-3+cell_size}" height="${-3+cell_size}" sprite="menu_empty3px" type="sliced" fillcenter="false" color="{# userlockedslot ? '255,0,0,150' : '0,255,0,150' }"/>
			</button>
			<sprite depth="3" name="iconSlotLockFill" width="${-3+cell_size}" height="${-3+cell_size}" sprite="menu_empty3px" type="sliced" fillcenter="true" visible="{# defined('userlockmode') and !userlockmode and userlockedslot }" color="255,0,0,150"/>
			<sprite depth="3" name="iconSlotLockBorder" width="${-3+cell_size}" height="${-3+cell_size}" sprite="menu_empty3px" type="sliced" fillcenter="false" visible="{# defined('userlockmode') and !userlockmode and userlockedslot }" color="255,0,0,150"/>
		</rect>
	</item_stackAGF>
</append>

<!-- Extra action row used by widened item info panel -->
<append xpath="/templates">
	<item_action_entry7>
		<rect height="31" controller="ItemActionEntry" disabled_font_color="[disabledLabelColor]" default_font_color="[labelColor]" default_background_color="[lightBrown]">
			<sprite depth="3" name="background" color="[lightBrown]" type="sliced" on_press="true" on_hover="true" width="147" sound_play_on_hover="[default_hover]" gamepad_selectable="false"/>
			<sprite depth="4" name="Icon" sprite="{actionicon}" size="24,24" color="{statuscolor}" pos="2,-3" foregroundlayer="true"/>
			<label depth="4" name="Name" pos="32,-15" width="78" height="26" text="{actionname}" font_size="26" color="{statuscolor}" effect="shadow" pivot="left" />
			<gamepad_icon depth="4" name="gamepadIcon" size="44,44" pos="146,-22" pivot="Right" visible="{inspectheld}" />
			<label depth="4" name="keyboardButton" pos="145,-15" width="36" height="26" text="&lt;W&gt;" font_size="26" color="{statuscolor}" effect="shadow" pivot="right" justify="center" />
		</rect>
	</item_action_entry7>
</append>

<!-- Unlocked-by section sized for widened backpack panels -->
<set xpath="/templates/unlocked_by_header/rect[@name='header']/@width">514</set>
<set xpath="/templates/unlocked_by_header/rect[@name='header']/rect[@width='304']/sprite[@name='backgroundMain']/@width">384</set>
<set xpath="/templates/unlocked_by_header/rect[@name='header']/rect[@width='304']/@width">383</set>
<set xpath="/templates/unlocked_by_header/rect[@name='header']/rect[@width='82']/@pos">443,0</set>

<set xpath="/templates/unlocked_by_row/rect[@name='row']/@width">514</set>
<set xpath="/templates/unlocked_by_row/rect[@name='row']/rect[@width='304']/sprite[@name='backgroundMain']/@width">384</set>
<set xpath="/templates/unlocked_by_row/rect[@name='row']/rect[@width='304']/@width">383</set>
<set xpath="/templates/unlocked_by_row/rect[@name='row']/rect/sprite[@name='backgroundMain']/@height">52</set>
<set xpath="/templates/unlocked_by_row/rect[@name='row']/rect[@width='82']/@pos">443,0</set>

<!-- Doom crafting list entries -->
<remove xpath="/templates/recipe_entry"/>
<append xpath="/templates">
	<recipe_entryAGF>
		<rect height="90" width="132" style="press, hover, scroll" controller="RecipeEntry" disabled_font_color="[disabledLabelColor]" enabled_font_color="[labelColor]" sound="[recipe_click]" sound_play_on_hover="[default_hover]" >
			<sprite depth="3" name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="132" height="90" color="[black]" type="sliced" fillcenter="false" />
			<sprite depth="2" name="background" width="128" height="88" pos="0,1" color="[darkGrey]" type="sliced" />
			<sprite depth="4" name="Icon" atlas="ItemIconAtlas" sprite="{recipeicon}" color="{recipeicontint}" size="56,56" pos="65,-28" pivot="center" foregroundlayer="true"/>
			<sprite depth="8" name="itemtypeicon" width="20" height="20" sprite="ui_game_symbol_{itemtypeicon}" pos="32,-2" foregroundlayer="true" visible="{hasitemtypeicon}" color="{itemtypeicontint}" />
			<label depth="4" name="Name" pos="63,-72" width="126" height="30" text="{recipename}" font_size="28" color="{hasingredientsstatecolor}" justify="center" pivot="center"/>
			<sprite depth="5" name="Favorite" sprite="server_favorite" size="20,20" pos="6,-4" visible="{isfavorite}" foregroundlayer="true"/>
			<sprite depth="4" name="Unlocked" sprite="{unlockicon}" size="24,24" pos="100,-10" visible="{isunlockable}" color="{unlockstatecolor}" foregroundlayer="true" />
		</rect>
	</recipe_entryAGF>
	<ingredient_entryAGF>
		<rect name="row" width="132" height="153" controller="IngredientEntry">
			<sprite depth="4" name="icon" width="40" height="40" atlas="ItemIconAtlas" sprite="{itemicon}" color="{itemicontint}" size="56,56" pos="65,-40" pivot="center" foregroundlayer="true"/>
			<label depth="3" name="name" pos="63,-92" width="126" height="30" font_size="28" color="[labelColor]" justify="center" pivot="center" text="{itemname}"/>
			<label depth="3" name="needCount" pos="63,-122" width="126" height="26" font_size="26" color="[labelColor]" justify="center" pivot="center" text="{haveneedcount}"/>
			<sprite depth="3" name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="132" height="153" color="[black]" type="sliced" fillcenter="false" />
			<sprite depth="2" name="background" width="128" height="151" pos="0,1" color="[darkGrey]" type="sliced" />
		</rect>
	</ingredient_entryAGF>
</append>

<!-- Party entry (Doom HUD) -->
<remove xpath="/templates/party_entry"/>
<append xpath="/templates">
	<party_entry>
		<rect width="200" height="38" controller="PartyEntry" visible="{partyvisible}" default_health_color="255,0,0,128" twitch_health_color="100,65,165,128">
			<sprite depth="1" name="border" color="0,0,0,128" type="sliced"/>
			<sprite depth="2" name="background" color="0,0,0,140" height="38" type="sliced" />
			<filledsprite depth="3" name="BarHealthModifiedMax" color="110,110,110,128" height="19" type="filled" fill="{healthmodifiedmax}" />
			<filledsprite depth="3" pos="0,-19" name="BarArmourModifiedMax" color="110,110,110,128" height="19" type="filled" fill="1" />
			<filledsprite depth="5" name="BarHealth" color="255,0,0,255" width="197" height="19" type="filled" fill="{healthfill}" />
			<rect depth="5" pos="0,-19" width="197" height="19" controller="DoomArmour.DoomArmourBar, DoomArmour">
				<filledsprite depth="5" name="BarArmour" color="255,100,0,255" width="197" height="19" type="filled" fill="{armourfill}" />
			</rect>
			<sprite depth="1" name="border" color="0,0,0,255" width="200" height="38" type="sliced" fillcenter="false"/>
			<filledsprite depth="8" name="BarHealthModifiedMax" color="0,0,0,255" width="199" fillcenter="false" type="filled" fill="{healthmodifiedmax}" />
			<filledsprite depth="3" name="BarHealthModifiedMax" color="0,0,0,255" width="199" fillcenter="false" type="filled" fill="{healthmodifiedmax}" />
			<label depth="6" name="TextContent" pos="30, -6" font_size="26" color="[white]" justify="left" pivot="topleft" text="{name}" height="30" width="100"/>
			<label depth="6" name="TextContent" pos="232,-6" font_size="26" color="{distancecolor}" pivot="topleft" text="{distance}" height="30" effect="outline"/>
			<sprite pos="135,-3" depth="8" name="icon2" style="icon30px" sprite="{icon2}" visible="{showicon2}" />
			<sprite pos="167,-3" depth="8" name="icon1" style="icon30px" sprite="{icon1}" visible="{showicon1}" />
			<sprite depth="8" name="arrowContent" style="icon22px" pos="216,-18" sprite="ui_game_symbol_map_player_arrow" visible="{showarrow}" pivot="center" color="{arrowcolor}" />
			<sprite depth="8" name="voiceStatus" style="icon22px" pos="15,-18" sprite="ui_game_symbol_talk" visible="{voicevisible}" pivot="center" color="{# voicemuted ? '200,0,0,255' : (voiceactive ? '255,255,255,255' : '128,128,128,255') }" />
		</rect>
	</party_entry>
</append>

</configs>
