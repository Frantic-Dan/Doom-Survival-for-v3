	<!-- Top-anchor: pos.x is the window CENTER. pos=0 centers the options column. -->
	<set xpath="/windows/window[@name='mainMenu']/@pos">0,-125</set>
	<set xpath="/windows/window[@name='mainMenu']/@width">400</set>
	<remove xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnCredits']"/>
	<remove xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnNews']"/>
	<set xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnPlayGame']/@nav_up">btnQuit</set>
	<!-- Keep grid at local 0 (same center line as the logo). Do not offset -200. -->
	<set xpath="/windows/window[@name='mainMenu']/grid/@pos">0,-450</set>
	<set xpath="/windows/window[@name='mainMenu']/grid/@cell_width">400</set>
	
	<set xpath="/windows/window[@name='mainMenuPlayerName']/@pos">-570,-50</set>
	<set xpath="/windows/window[@name='mainMenuPlayerName']/@anchor">top</set>
	
	<set xpath="/windows/window[@name='mainMenuVersion']/@pos">-810,-50</set>
	<set xpath="/windows/window[@name='mainMenuVersion']/@anchor">top</set>
	
	<set xpath="/windows/window[@name='mainMenuDiscordButton']/@pos">810,-50</set>
	<set xpath="/windows/window[@name='mainMenuDiscordButton']/@anchor">top</set>
	
