<configs>
	<!-- Doom on 3.3: bag starts at 60 and caps at 90. Carry starts at 60. -->
	<conditional>
		<if cond="game_version() &gt;= version(1,3,30)">
			<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='BagSize']/@value">60</set>
			<set xpath="/entity_classes/entity_class[@name='playerMale']/property[@name='MaxBagSize']/@value">90</set>
			<set xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/triggered_effect[@cvar='.carryCapacityBase'][@value='32']/@value">60</set>
		</if>
	</conditional>
</configs>
