		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="7">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="3.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="3"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="8">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="2.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="2"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="9">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="1.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="1"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="0.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
        
