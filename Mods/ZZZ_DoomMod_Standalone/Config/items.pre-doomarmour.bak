		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" cvar=".DiseaseRoll" operation="set" value="3"/>
		<display_value name="dDysenteryRisk" value=".03"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" cvar=".DiseaseRoll" operation="add" value="@$MetabolismResist"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffDysenteryCatchFood">
			<requirement name="RandomRoll" seed_type="Random" min_max="1,100" operation="LTE" value="@.DiseaseRoll"/>
		</triggered_effect>
	</effect_group>
</item>
</insertafter>

