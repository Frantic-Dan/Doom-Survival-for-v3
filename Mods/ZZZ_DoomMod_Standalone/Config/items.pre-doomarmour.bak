		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="4">
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/>
