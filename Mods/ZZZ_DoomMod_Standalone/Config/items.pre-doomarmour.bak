		<passive_effect name="BlockDamage" operation="base_set" value="5.1" tags="perkBoomstick"/>
		<passive_effect name="BlockDamage" operation="base_add" value="100" tags="barrelExplosive"/>
		<passive_effect name="RoundRayCount" operation="base_set" value="20" tags="perkBoomstick"/>
		<passive_effect name="MaxRange" operation="base_set" value="60" tags="perkBoomstick"/>
		<passive_effect name="DamageFalloffRange" operation="base_set" value="44" tags="perkBoomstick"/>
		<passive_effect name="BlockPenetrationFactor" operation="base_set" value="51" tags="perkBoomstick"/>
		<passive_effect name="SpreadDegreesVertical" operation="base_set" value="9.5" tags="perkBoomstick"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value="9.5" tags="perkBoomstick"/>
		<passive_effect name="SpreadMultiplierAiming" operation="perc_add" value="-.25" tags="perkBoomstick"/>
		<passive_effect name="SpreadMultiplierCrouching" operation="perc_add" value="-.05" tags="perkBoomstick"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="-1" tags="earth"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="-.6" tags="metal"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="-.4" tags="stone"/>
		<passive_effect name="EntityPenetrationCount" operation="base_set" value="0" tags="superShotgun"/>
	</effect_group>
	<effect_group >
			<triggered_effect trigger="onSelfPrimaryActionStart" action="CallGameEvent" target="self" event="RemoveShell" allow_client_call="true"/>
			<requirement name="RoundsInMagazine" operation="Equals" value="1"/>
	</effect_group>
	<effect_group >
			<triggered_effect trigger="onSelfPrimaryActionStart" action="CallGameEvent" target="self" event="RefundShells" allow_client_call="true"/>
			<requirement name="RoundsInMagazine" operation="Equals" value="1"/>
	</effect_group>
</item>

