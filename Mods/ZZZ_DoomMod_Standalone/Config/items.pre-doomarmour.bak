	<property name="SoundPickup" value="sewingkit_grab"/>
	<property name="SoundPlace" value="sewingkit_place"/>
	<property class="Action1">
		<property name="Class" value="Eat"/>
		<property name="Delay" value="1.0"/>
		<property name="Use_time" value="..."/>
		<property name="Sound_start" value="player_blooddraw"/>
		<property name="Consume" value="false"/>
		<property name="Create_item" value="medicalBloodBag"/>
	</property>

	<effect_group tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyStats" stat="Health" operation="add" value="-20"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyStats" stat="Water" operation="add" value="-20"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyStats" stat="Food" operation="add" value="-10"/>
		<triggered_effect trigger="onSelfSecondaryActionStart" action="ModifyCVar" cvar="$fatiguedCounterDM" operation="add" value="903"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" cvar="$fatiguedCounterDM" operation="set" value="3608">
			<requirement name="CVarCompare" cvar="$fatiguedCounterDM" operation="GT" value="3608"/></triggered_effect>
		
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFatiguedDM"/>
		<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffBloodLoss">
			<requirement name="CVarCompare" cvar="$fatiguedCounterDM" operation="GT" value="1500"/></triggered_effect>
		<!-- <triggered_effect trigger="onSelfPrimaryActionStart" action="ModifyCVar" cvar="$bloodlossDeathPenalty" operation="add" value="5">
				<requirement name="HasBuff" buff="buffBloodLoss"/></triggered_effect> -->
		<triggered_effect trigger="onSelfSecondaryActionStart" action="AddBuff" buff="buffBloodLossDeathPenalty">
			<requirement name="HasBuff" buff="buffBloodLoss"/></triggered_effect>
		<triggered_effect trigger="onSelfSecondaryActionStart" action="ModifyStats" stat="Health" operation="add" value="-999">
			<requirement name="HasBuff" buff="buffBloodLoss"/></triggered_effect>
		<display_value name="foodHealthAmount" value="-20"/>
		<display_value name="$waterAmountAdd" value="-20"/>
		<display_value name="$foodAmountAdd" value="-10"/>
	</effect_group>
</item>

