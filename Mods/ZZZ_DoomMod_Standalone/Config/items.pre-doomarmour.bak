<append xpath="/items">
<item name="meleeHandFormerSergeant">
	<property name="Extends" value="meleeHandMaster"/>
	<property name="CreativeMode" value="None"/>
	<property name="Degradation" value="99999" param1="true"/>
	<property class="Action0">
		<property name="DamageEntity" value="0"/>
		<property name="DamageBlock" value="10"/>
		<property name="Range" value="1.6"/>
	</property>
	<property class="Action1"> <!-- UseAction -->
		<property name="Class" value="Vomit"/>
		<property name="Hitmask_override" value="Arrow"/>
		<!-- <property name="AnimType" value="1"/> -->
		<!-- <property name="AnimWait" value="0.17"/>
		<property name="WarningDelay" value=".1"/> -->
		<property name="WarningMax" value="0"/>
		<!-- <property name="Delay" value=".01"/> --> <!-- obsolete if rounds per minute exists -->
		<property name="Range" value="200"/>
		<property name="Infinite_ammo" value="true"/>
		<property name="Magazine_items" value="meleeHandDemonSergeantShell"/>
		<property name="Particles_muzzle_fire" value="gunfire_MG_M60"/>
		<property name="Sound_warning" value="VRpumpSG_fire"/>
		<property name="Sound_start" value=""/>
		<property name="Sound_repeat" value=""/>
		<property name="Sound_end" value=""/>
		<property name="Sound_empty" value=""/>
		<property name="Sound_reload" value="shotgun_reload"/>
	</property>
	<effect_group name="meleeHandFormerSergeant" tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<!-- <passive_effect name="AttacksPerMinute" operation="base_set" value="120"/> -->
		<passive_effect name="DamageFalloffRange" operation="base_set" value="100"/>
		<passive_effect name="MaxRange" operation="base_set" value="100"/>
		<passive_effect name="MagazineSize" operation="base_set" value="1"/>
		<passive_effect name="BurstRoundCount" operation="base_set" value="3"/>
		<passive_effect name="SpreadDegreesVertical" operation="base_set" value="4.5"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value="4.5"/>
		<passive_effect name="SpreadMultiplierIdle" operation="base_set" value=".01"/>
		<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" fireOneBuff="true"
			buff="buffArmSprainedCHTrigger,buffLegSprainedCHTrigger,buffLaceration,buffInjuryBleedingTwo"
			weights=".08,.08,.06,.12"/>
	</effect_group>

	<effect_group name="meleeHandFormerSergeant" tiered="false">
		<!-- <requirement name="!EntityTagCompare" target="other" tags="imp"/> -->
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="0"/>
		<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/></passive_effect>
	</effect_group>
	<effect_group name="meleeHandFormerSergeant" tiered="false">
		<requirements>
			<requirement name="EntityTagCompare" target="other" tags="player"/>
			<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/>
		</requirements>
		<passive_effect name="EntityDamage" operation="base_set" value="6">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="4"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="7">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="3.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="3"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="8">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="2.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="2"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="9">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="1.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="1"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="0.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
        
		<passive_effect name="EntityDamage" operation="base_set" value="4">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="6"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="5">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="5.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="5"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="6">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="4.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="4"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="7">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="3.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="3"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="8">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="2.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="2"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="9">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="1.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="1"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="0.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_subtract" value="1">
			<requirement name="ProgressionLevel" target="other" progression_name="perkPainTolerance" operation="EQ" value="1"/>
		</passive_effect>
		<passive_effect name="EntityDamage" operation="base_subtract" value="2">
			<requirement name="ProgressionLevel" target="other" progression_name="perkPainTolerance" operation="EQ" value="2"/>
		</passive_effect>
		<passive_effect name="EntityDamage" operation="base_subtract" value="3">
			<requirement name="ProgressionLevel" target="other" progression_name="perkPainTolerance" operation="EQ" value="3"/>
		</passive_effect>
		<passive_effect name="EntityDamage" operation="base_subtract" value="1">
			<requirement name="ProgressionLevel" target="other" progression_name="perkAdrenalineRush" operation="GTE" value="3"/>
			<requirement name="StatCompareCurrent" target="other" stat="health" operation="LTE" value="50"/>
		</passive_effect>
		<!-- <passive_effect name="EntityDamage" operation="base_subtract" value="1">
			<requirement name="CVarCompare" cvar="_difficulty" operation="Equals" value="0"/>
		</passive_effect> -->
	</effect_group>
	<!-- <effect_group name="meleeHandFormerSergeant" tiered="false">
		<requirement name="EntityTagCompare" target="other" tags="player"/>
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="add" value="1">
