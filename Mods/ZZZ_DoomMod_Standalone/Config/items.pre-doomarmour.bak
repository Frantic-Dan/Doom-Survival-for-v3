		<passive_effect name="DamageFalloffRange" operation="base_set" value="100" tags="perkDemolitionsExpert"/>
		<passive_effect name="ReloadSpeedMultiplier" operation="base_set" value="1" tags="perkDemolitionsExpert"/>
