		<passive_effect name="KickDegreesHorizontalMin" operation="base_set" value="-1.5" tags="perkDemolitionsExpert"/>
		<passive_effect name="KickDegreesHorizontalMax" operation="base_set" value="1.5" tags="perkDemolitionsExpert"/> -->
		
		<passive_effect name="SpreadDegreesVertical" operation="base_set" value="1" tags="perkDemolitionsExpert"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value="1" tags="perkDemolitionsExpert"/>
