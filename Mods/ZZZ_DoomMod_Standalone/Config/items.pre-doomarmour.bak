		<passive_effect name="WeaponHandling" operation="perc_add" value="1" tags="perkBFGExpert"/> <!-- random WeaponHandling -->
		<!-- <passive_effect name="RoundsPerMinute" operation="base_set" value="480" tags="perkBFGExpert"/> -->
		<passive_effect name="BurstRoundCount" operation="base_set" value="1" tags="perkBFGExpert"/>
		<passive_effect name="MagazineSize" operation="base_set" value="100" tags="perkBFGExpert"/>
		<passive_effect name="ReloadSpeedMultiplier" operation="base_set" value="2" tags="perkBFGExpert"/> <!-- 3.8s -->

		<passive_effect name="SpreadDegreesVertical" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="SpreadMultiplierAiming" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="SpreadMultiplierCrouching" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="SpreadMultiplierWalking" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="SpreadMultiplierRunning" operation="base_set" value="0" tags="perkBFGExpert"/>

		<passive_effect name="KickDegreesVerticalMin" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="KickDegreesVerticalMax" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="KickDegreesHorizontalMin" operation="base_set" value="0" tags="perkBFGExpert"/>
		<passive_effect name="KickDegreesHorizontalMax" operation="base_set" value="0" tags="perkBFGExpert"/>

		<passive_effect name="WeaponHandling" operation="base_set" value="1" tags="perkBFGExpert"/> <!-- ak47 -->

		<passive_effect name="ModSlots" operation="base_set" value="0" />
		<passive_effect name="ProjectileVelocity" operation="base_add" value="0" tags="perkBFGExpert"/>
	</effect_group>
	<effect_group >
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="CallGameEvent" target="self" event="RemoveEnergyCell40" allow_client_call="true"/>
	</effect_group>
</item>

<item name="DummyBFGCellEntity">
	<!-- <property name="CreativeMode" value="None"/> -->
	<property name="Tags" value="ammo,perkBFGExpert,corpseRemoval"/>
	<!-- <property name="DisplayType" value="ammoLauncher"/> -->
	<property name="CustomIcon" value="PlasmaCellBattery"/>
	<property name="CustomIconTint" value="0000FF"/>
	<!-- <property name="Meshfile" value="@:Other/Items/Weapons/Ranged/RocketLauncher/rocketPrefab.prefab"/> -->
	<property name="Meshfile" value="#@modfolder:Resources/BFGballProjectile.unity3d?BFGball"/>
	<property name="HoldType" value="45"/>
	<property name="DescriptionKey" value="DummyBFGCellEntitydesc"/>
	<property name="HandMeshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
	<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
	<property name="Material" value="Mmetal"/>
	<property name="Weight" value="0"/>
	<property name="Stacknumber" value="100"/>
	<property name="EconomicValue" value="0"/>
	<property name="SellableToTrader" value="false"/>
	<property name="Group" value="Ammo/Weapons,Ammo,Ranged Weapons"/>
	<property name="SoundPickup" value="rocket_grab"/>
	<property name="SoundPlace" value="rocket_place"/>
	
	<property class="Action1">
		<property name="Class" value="Projectile"/>
		<property name="CustomProjectileType" value="GameObject,FullautoLauncher"/>
		<property class="Explosion">
			<property name="ParticleIndex" value="5"/>
			<property name="BlockDamage" value="5"/>
			<property name="EntityDamage" value="600"/>
			<property name="DamageType" value="Electrical"/>
			<property name="RadiusBlocks" value="5"/> <!-- damage radius for blocks -->
			<property name="RadiusEntities" value="10"/> <!-- damage radius for entities -->
			<property class="DamageBonus">
				<property name="water" value="0"/>
			</property>
		</property>
		<!-- <property name="Explosion.BlockDamage" value="5"/>
		<property name="Explosion.EntityDamage" value="600"/>
		<property name="Explosion.DamageType" value="Electrical"/>
		<property name="Explosion.RadiusBlocks" value="5"/>
		<property name="Explosion.RadiusEntities" value="10"/>
		<property name="Explosion.ParticleIndex" value="5"/>
		<property name="Explosion.DamageBonus.water" value="0"/> -->
		<property name="Gravity" value="-.01"/>
		<property name="FlyTime" value=".2"/>
		<property name="LifeTime" value="30"/>
		<property name="CollisionRadius" value=".2"/>
	</property>
	<effect_group name="DummyBFGCellEntity" tiered="false">
		<passive_effect name="BlockDamage" operation="base_set" value="5" />
		<passive_effect name="EntityDamage" operation="base_set" value="10" />
		<passive_effect name="ExplosionEntityDamage" operation="base_add" value="600">
				<requirement name="EntityTagCompare" target="other" tags="CyberDamage"/>
		</passive_effect>
		<passive_effect name="ProjectileVelocity" operation="base_set" value="20" tags="perkBFGExpert"/>
		<display_value name="dExRadius" value="10"/>
		<display_value name="dExBlockDamage" value="5"/>
		<display_value name="dExEntityDamage" value="600"/>
	</effect_group>
	<!-- <effect_group tiered="false" name="Shell Display"> --><!--<This Needs To Be Added on your Grenades/>-->
		<!-- <requirement name="AmmoIndexIs" value="0"/>
			<triggered_effect trigger="onReloadAboutToStart" action="AnimatorSetInt" property="ammoIndex"  value="0"></triggered_effect>
			<triggered_effect trigger="onSelfHoldingItemCreated" action="AnimatorSetInt" property="ammoIndex"  value="0"></triggered_effect>
	</effect_group> -->
</item>

