			<!-- <triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" buff="buffflamethrowerburn">
			</triggered_effect> -->
			
			<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" buff="buffflamethrowerburnQ5">
				<requirement name="CVarCompare" target="other" cvar="_underwater" operation="LT" value="0.3"/>
			</triggered_effect>
			
			<passive_effect name="EntityDamage" operation="base_set" value="0" />
			<passive_effect name="BlockDamage" operation="base_set" value="0" />
			<passive_effect name="RoundRayCount" operation="base_set" value="1" />
			<passive_effect name="MaxRange" operation="base_set" value="9.8" />
			<passive_effect name="DamageFalloffRange" operation="base_set" value="9.8" />
			<passive_effect name="EntityPenetrationCount" operation="base_set" value="5" />
			<passive_effect name="BlockPenetrationFactor" operation="base_set" value="51" />
			<passive_effect name="SpreadDegreesVertical" operation="base_set" value=".2" />
			<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value=".2" />
			<passive_effect name="SpreadMultiplierAiming" operation="perc_add" value="0" />
			<passive_effect name="SpreadMultiplierCrouching" operation="perc_add" value="0" />
			<passive_effect name="SpreadMultiplierWalking" operation="perc_add" value="0" />
			<passive_effect name="SpreadMultiplierRunning" operation="perc_add" value="0" />
			<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Health" operation="add" value="1"/>
	</effect_group>
	<effect_group >
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="CallGameEvent" target="self" event="RemoveFlameFuel" allow_client_call="true"/>
	</effect_group>
</item>

