<item name="InvulnerabilityPowerup">
	<property name="Tags" value="drinks,fitness,powerupitem"/>
	<property name="HoldType" value="3"/>
<!-- 	<property name="DisplayType" value="waterDysentery"/> -->
	<property name="Meshfile" value="@:Other/Items/Food/masonJarWaterPrefab.prefab"/>
	<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
	<property name="CustomIcon" value="invulnerability-sphere"/>
	<!-- <property name="CustomIconTint" value="00FF00"/> -->
	<property name="DescriptionKey" value="InvulnerabilityPowerupDesc"/>
	<property name="Material" value="Mglass"/>
	<property name="Stacknumber" value="2"/> <!-- STK drink -->
	<property name="Weight" value="0"/>
	<property name="EconomicValue" value="1000"/>
	<property name="SellableToTrader" value="false"/>
	<property name="CraftingIngredientTime" value="15"/>
	<property name="SoundPickup" value="firstaidkit_grab"/>
	<property name="SoundPlace" value="firstaidkit_place"/>
	<property class="Action1">
		<property name="Class" value="Eat"/>
		<property name="Delay" value="1"/>
		<!-- <property name="UseAnimation" value="false"/> -->
		<property name="Sound_start" value="use_powerup"/>
		<property name="Sound_in_head" value="true"/>
		<requirement name="!HasBuff" buff="buffInvulnerability"/>
	</property>
	<property name="Group" value="Medical"/>
	
	<effect_group tiered="false" name="InvulnerabilityPowerup">
			<display_value name="dDuration" value="41"/>
			<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" cvar="$buffInvulnerabilityDuration" operation="add" value="41"/>
			<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" cvar="$buffInvulnerabilityDuration" operation="set" value="41">
				<requirement name="CVarCompare" cvar="$buffInvulnerabilityDuration" operation="GT" value="41"/></triggered_effect>
			<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffInvulnerability"/>
	</effect_group>
</item>

