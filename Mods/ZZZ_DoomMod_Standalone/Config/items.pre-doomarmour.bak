			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="1"/>
		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="2">
