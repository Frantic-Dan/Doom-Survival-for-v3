	<property name="SoundPlace" value="powertool_big_place"/>
	<property name="HasReloadAnim" value="false"/>
	<property class="Action0">
		<requirement name="PlayerItemCount" item_name="ammoGasCan" operation="GTE" value="1"/>
		<requirement name="RoundsInMagazine" operation="Equals" value="3000"/>
		<property name="Class" value="Ranged"/>
		<property name="Hitmask_override" value="Melee"/> <!-- "Class" value="Ranged" is hardcoded to never collide with grass regardless -->
