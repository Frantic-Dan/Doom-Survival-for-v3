			<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="3"/>
		</triggered_effect>
	</effect_group> -->
</item>

<item name="meleeHandDemonSoldierBullet">
	<property name="Meshfile" value="@:Entities/Electrical/steel_dartPrefab.prefab"/>
	<property name="Material" value="Mmetal"/>
	<property name="CreativeMode" value="None"/>
	<property name="CustomIcon" value="missingIcon"/>
	<property class="Action1">
		<property name="Class" value="Projectile"/>
		<property name="DamageEntity" value="10"/>
		<property name="DamageBlock" value="10"/>
		<property class="Explosion">
			<property name="ParticleIndex" value="0"/>
		</property>
		<property name="Velocity" value="250"/>
		<property name="Gravity" value=".01"/>
		<property name="CollisionRadius" value=".05"/>
		<property name="FlyTime" value="0"/>
		<property name="LifeTime" value="20"/>
	</property>
	<effect_group name="meleeHandDemonSoldierBullet" tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<passive_effect name="DamageModifier" operation="perc_set" value="-.8" tags="earth"/>
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="abrasionZombieHit" operation="set" value="900"/><!--AbrasionRegular-->
	</effect_group>
</item>
</append>

