		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="0"/>
		<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/></passive_effect>
	</effect_group>
