	<remove xpath="/items/item[@name='toolAnvil']/effect_group[2]"/>
	<insertafter xpath="/items/item[@name='toolAnvil']/effect_group[1]">
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="0"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.2,-.3,-.4,-.5,-.6,-.7" tier="1,2,3,4,5,6"/>
				<display_value name="dCraftingTime" value=".2,.3,.4,.5,.6,.7" tier="1,2,3,4,5,6"/>
		</effect_group>
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="1"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.17,-.255,-.34,-.425,-.51,-.595" tier="1,2,3,4,5,6"/>
		</effect_group>
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="2"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.14,-.21,-.28,-.35,-.42,-.49" tier="1,2,3,4,5,6"/>
		</effect_group>
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="3"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.11,-.165,-.22,-.275,-.33,-.385" tier="1,2,3,4,5,6"/>
		</effect_group>
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="4"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.08,-.12,-.16,-.2,-.24,-.28" tier="1,2,3,4,5,6"/>
		</effect_group>
		<effect_group tiered="false">
			<requirement name="!HoldingItemHasTags" tags="toolAnvil"/>
			<requirement name="ProgressionLevel" progression_name="perkQuickerCrafting" operation="Equals" value="5"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.05,-.075,-.1,-.125,-.15,-.175" tier="1,2,3,4,5,6"/>
		</effect_group>
	</insertafter>
	
