		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="5">
			<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0.4"/>
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="3"/>
		</triggered_effect>
        
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="12">
			<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0.4"/>
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="2"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="0"/>
		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="11">
			<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0.4"/>
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="2"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="1"/>
		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="10">
			<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0.4"/>
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="2"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="2"/>
		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="subtract" value="9">
			<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="0.4"/>
			<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="2"/>
			<requirement name="ProgressionLevel" target="other" progression_name="perkReinforcedArmour" operation="EQ" value="3"/>
		</triggered_effect>
	</effect_group> -->
	<effect_group>
		<passive_effect name="DamageModifier" operation="perc_set" value="0" tags="earth"/>
		<passive_effect name="DamageModifier" operation="perc_set" value="-.5" tags="stone"/>
		<passive_effect name="DamageModifier" operation="perc_set" value="-.5" tags="metal"/>
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="abrasionZombieHit" operation="set" value="1800"/><!--AbrasionRegular-->
