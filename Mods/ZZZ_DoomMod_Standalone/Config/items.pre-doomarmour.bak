</conditional> -->

<append xpath="/items">
<item name="meleeHandDemonNightmareImp">
	<property name="Extends" value="meleeHandMaster"/>
	<property name="CreativeMode" value="None"/>
	<property class="Action0">
		<property name="DamageEntity" value="0"/>
		<property name="DamageBlock" value="30"/>
		<property name="Range" value="1.7"/>
		<property name="Delay" value=".2"/>
		<property class="HitSounds">
		<property name="Override0" value="organic" param1="metalstaborganic"/></property>
	</property>
	<property class="Action1"> <!-- UseAction -->
		<property name="Class" value="Vomit"/>
		<property name="Hitmask_override" value="Arrow"/>
		<property name="AnimType" value="2"/>
		<property name="WarningMax" value="0"/>
		<property name="Delay" value=".25"/> <!-- obsolete if rounds per minute exists -->
		<property name="Range" value="100"/>
		<property name="Infinite_ammo" value="true"/>
		<property name="Magazine_items" value="meleeHandDemonNightmareImpProjectile"/>
	</property>
	<effect_group name="meleeHandDemonNightmareImp" tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<!-- <passive_effect name="AttacksPerMinute" operation="base_set" value="120"/> -->
		<passive_effect name="DamageFalloffRange" operation="base_set" value="100"/>
		<passive_effect name="MaxRange" operation="base_set" value="100"/>
		<passive_effect name="MagazineSize" operation="base_set" value="1"/>
		<passive_effect name="BurstRoundCount" operation="base_set" value="1"/>
		<passive_effect name="SpreadDegreesVertical" operation="base_set" value=".01"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value=".01"/>
		<passive_effect name="SpreadMultiplierIdle" operation="base_set" value=".01"/>
		<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" fireOneBuff="true"
			buff="buffArmSprainedCHTrigger,buffLegSprainedCHTrigger,buffLaceration,buffInjuryStunned01CHTrigger,buffInjuryBleedingTwo,buffInfectionMain"
			weights=".08,.08,.06,.16,.12,.03"/>
	</effect_group>

	<effect_group name="meleeHandDemonNightmareImp" tiered="false">
		<!-- <requirement name="!EntityTagCompare" target="other" tags="imp"/> -->
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<passive_effect name="EntityDamage" operation="base_set" value="15">
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="0"/>
		<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/></passive_effect>
	</effect_group>
	<effect_group name="meleeHandDemonNightmareImp" tiered="false">
		<requirements>
			<requirement name="EntityTagCompare" target="other" tags="player"/>
			<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/>
		</requirements>
		<passive_effect name="EntityDamage" operation="base_set" value="9">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="6"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="10">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="5.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="5"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="11">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="4.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="4"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
		<passive_effect name="EntityDamage" operation="base_set" value="12">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="LTE" value="3.2"/>
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="3"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
