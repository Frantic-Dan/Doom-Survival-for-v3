<append xpath="/items">
<item name="meleeHandDemonMancubus">
	<property name="Extends" value="meleeHandMaster"/>
	<property name="CreativeMode" value="None"/>
	<property class="Action0">
		<property name="DamageEntity" value="0"/>
		<property name="DamageBlock" value="70"/>
		<property name="Range" value="1.9"/>
	</property>
	<property class="Action1"> <!-- UseAction -->
		<property name="Class" value="Vomit"/>
		<property name="Hitmask_override" value="Arrow"/>
		<!-- <property name="AnimType" value="2"/> -->
		<property name="WarningMax" value="1"/>
		<property name="Delay" value=".5"/> <!-- obsolete if rounds per minute exists -->
		<property name="Range" value="100"/>
		<property name="Infinite_ammo" value="true"/>
		<property name="Magazine_items" value="meleeHandDemonMancubusProjectile"/>
		<property name="Sound_warning" value="MancabusAttack"/>
		<property name="Sound_start" value="DemonFireballThrown"/>
		<property name="Sound_repeat" value=""/>
		<property name="Sound_end" value=""/>
		<property name="Sound_empty" value=""/>
		<property name="Sound_reload" value=""/>
	</property>
	<effect_group name="meleeHandDemonMancubus" tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<passive_effect name="DamageFalloffRange" operation="base_set" value="100"/>
		<passive_effect name="MaxRange" operation="base_set" value="100"/>
		<passive_effect name="MagazineSize" operation="base_set" value="3"/>
		<passive_effect name="BurstRoundCount" operation="base_set" value="2"/>
		<passive_effect name="SpreadDegreesVertical" operation="base_set" value=".01"/>
		<passive_effect name="SpreadDegreesHorizontal" operation="base_set" value="7"/>
		<passive_effect name="SpreadMultiplierIdle" operation="base_set" value=".01"/>
		<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" fireOneBuff="true"
			buff="buffArmSprainedCHTrigger,buffLegSprainedCHTrigger,buffLaceration,buffAbrasionCatch,buffInjuryStunned01CHTrigger,buffInjuryBleedingTwo,buffInfectionMain"
			weights=".14,.14,.1,.4,.5,.22,.05"/>
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="infectionCounter" operation="add" value="10"><!--InfectionRegular-->
			<requirement name="CVarCompare" target="other" cvar="infectionCounter" operation="GT" value="0"/></triggered_effect>
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="abrasionZombieHit" operation="set" value="1800"/><!--AbrasionRegular-->
	</effect_group>

	<effect_group name="meleeHandDemonMancubus" tiered="false">
		<!-- <requirement name="!EntityTagCompare" target="other" tags="imp"/> -->
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<passive_effect name="EntityDamage" operation="base_set" value="35">
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="0"/>
		<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="0"/>
		<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/></passive_effect>
	</effect_group>
	<effect_group name="meleeHandDemonMancubus" tiered="false">
		<requirements>
			<requirement name="EntityTagCompare" target="other" tags="player"/>
			<requirement name="!HasBuff" target="other" buff="buffInvulnerability"/>
		</requirements>
		<passive_effect name="EntityDamage" operation="base_set" value="21">
		<requirement name="StatCompareCurrent" target="other" stat="Stamina" operation="GTE" value="14"/>
		<requirement name="CVarCompare" target="other" cvar="armourType" operation="Equals" value="1"/></passive_effect>
		
