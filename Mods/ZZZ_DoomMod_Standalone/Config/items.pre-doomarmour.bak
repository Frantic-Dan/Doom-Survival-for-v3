<item name="meleeHandDemonBabyCacoProjectile">
	<property name="Meshfile" value="#@modfolder:Resources/CacodemonProjectile.unity3d?CacodemonFireball"/>
	<!-- <property name="Meshfile" value="@:Other/Items/Weapons/Ranged/Vomit/vomitBulbPrefab.prefab"/> -->
	<!-- <property name="Meshfile" value="@:Other/Items/Weapons/Ranged/Vomit/vomitRadPrefab.prefab"/> -->
	<property name="Material" value="Morganic"/>
	<property name="CreativeMode" value="None"/>
	<property name="CustomIcon" value="missingIcon"/>
	<property class="Action1">
		<property name="Class" value="Projectile"/>
		<property name="DamageEntity" value="0"/>
		<property name="DamageBlock" value="20"/>
		<property class="Explosion">
			<property name="ParticleIndex" value="10"/>
			<property name="RadiusBlocks" value="1"/>
			<property name="Duration" value="2"/>
			<property name="BlockDamage" value="40"/>
			<property class="DamageBonus">
				<property name="earth" value=".2"/>
				<property name="water" value="0"/>
			</property>
		</property>
		<!-- <property name="Explosion.ParticleIndex" value="10"/>
		<property name="Explosion.Duration" value="2"/>
		<property name="Explosion.RadiusBlocks" value="1"/> -->
		<!-- <property name="Explosion.RadiusEntities" value="3.9"/>
		<property name="Explosion.EntityDamage" value="80"/> -->
		<!-- <property name="Explosion.BlockDamage" value="40"/>
		<property name="Explosion.DamageBonus.earth" value=".2"/>
		<property name="Explosion.DamageBonus.water" value="0"/> -->
		<!-- <property name="FlyTime" value="-5"/> --><!-- -value calculates ballistic velocity to target over this +duration -->
		<property name="Velocity" value="10"/>
		<property name="Gravity" value=".01"/>
		<!-- <property name="LifeTime" value="7"/> -->
		<property name="CollisionRadius" value=".1"/>
		<!-- <property name="Gravity" value="-1.5"/> -->
		<property name="FlyTime" value="0"/>
		<property name="LifeTime" value="20"/>
		<property name="Buff" value="buff2ndDegreeBurn"/>
	</property>
	<effect_group name="meleeHandDemonBabyCacoProjectile" tiered="false">
		<passive_effect name="ModSlots" operation="base_set" value="0"/>
		<triggered_effect trigger="onSelfFirstSpawn" action="AttachParticleEffectToEntity" particle="torch02_firePrefab" /> <!-- p_candle_firstperson -->
		<passive_effect name="DamageModifier" operation="perc_set" value="-.8" tags="earth"/>
		<!-- <passive_effect name="BuffProcChance" operation="base_set" value=".1" tags="buff2ndDegreeBurn"/> -->
		<!-- <passive_effect name="BlockDamage" operation="base_set" value="15"/> -->
		<!-- <triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" fireOneBuff="true"
			buff="buff2ndDegreeBurn"
			weights=".4"/> -->
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="$buff2ndDegreeBurnDuration" operation="add" value="10">
			<requirement name="CVarCompare" target="other" cvar="$buff2ndDegreeBurnDuration" operation="GT" value="0"/></triggered_effect>
		<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="abrasionZombieHit" operation="set" value="1800"/><!--AbrasionRegular-->
	</effect_group>
</item>
</append>

