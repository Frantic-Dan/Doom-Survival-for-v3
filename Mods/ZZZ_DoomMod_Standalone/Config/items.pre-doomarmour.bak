			<requirement name="ProgressionLevel" target="other" progression_name="perkAdrenalineRush" operation="GTE" value="3"/>
		</triggered_effect>
		
		<triggered_effect trigger="onSelfDamagedOther" action="ModifyStats" target="other" stat="Stamina" operation="add" value="1">
			<requirement name="CVarCompare" target="other" cvar="armourTypeBlue" operation="Equals" value="1"/>
