		<passive_effect name="RoundsPerMinute" operation="base_set" value="66" tags="perkDemolitionsExpert"/>
		<passive_effect name="RoundsPerMinute" operation="perc_add" value=".005"/>
		<passive_effect name="BurstRoundCount" operation="base_set" value="1" tags="perkDemolitionsExpert"/>
		<!-- <passive_effect name="PartialReloadCount" operation="base_set" value="1000" tags="perkDemolitionsExpert"/> -->
