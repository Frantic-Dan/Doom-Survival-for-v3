	<property name="Tags" value="IZY,overrideSounds,weapon,ranged,flamethrower,gun,shortRange,barrelAttachments,sideAttachments,smallTopAttachments,noScopes,stock,bottomAttachments,attIntellect,corpseRemoval,canHaveCosmetic"/>
