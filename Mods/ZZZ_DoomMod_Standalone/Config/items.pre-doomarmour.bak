<FranticDan>
	
	<set xpath="/items/item[@name='resourceSpring']/property[@name='Material']/@value">MresourceForgedIron</set>
	<set xpath="/items/item[@name='resourceHeadlight']/property[@name='Material']/@value">Mglass</set>
	<set xpath="/items/item[@name='resourceWood']/property[@name='FuelValue']/@value">30</set>
	<set xpath="/items/item[@name='resourceCoal']/property[@name='FuelValue']/@value">120</set>
	<insertafter xpath="/items/item[@name='questMaster']/property[@name='Material']">
		<property name="NoScrapping" value="true"/>
	</insertafter>
	
	<insertafter xpath="/items/item[@name='unit_clay']">
	<item name="unit_steel">
		<property name="Extends" value="unit_iron"/>
		<property name="CustomIcon" value="resourceScrapSteel"/>
		<property name="Material" value="MresourceForgedSteel"/>
		<property name="MeltTimePerUnit" value="1"/>
		<property name="CreativeMode" value="None"/>
		<property name="SoundPickup" value="scrapiron_grab" />
		<property name="SoundPlace" value="scrapiron_place" />
	</item>
	
	<item name="unit_carbon">
		<property name="Extends" value="unit_iron"/>
		<property name="CustomIcon" value="resourceCoal"/>
		<property name="Material" value="MresourceCoalSmelt"/>
		<property name="MeltTimePerUnit" value="5"/>
		<property name="CreativeMode" value="None"/>
		<property name="SoundPickup" value="coal_grab"/>
		<property name="SoundPlace" value="coal_place"/>
	</item>
	</insertafter>
	
	<set xpath="/items/item[@name='resourceCoal']/property[@name='Material']/@value">MresourceCoalSmelt</set>
	<insertafter xpath="/items/item[@name='resourceCoal']/property[@name='Material']">
		<property name="MeltTimePerUnit" value="5"/>
	</insertafter>
	
	<insertafter xpath="/items/item[@name='resourceScrapIron']">
	<item name="resourceScrapSteel"> <!-- scrap material -->
		<property name="HoldType" value="45"/>
		<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
		<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
		<property name="CustomIcon" value="resourceScrapSteel"/>
		<property name="Material" value="MresourceForgedSteel"/>
		<property name="Weight" value="1"/>
		<property name="Stacknumber" value="6000"/> <!-- STK resource -->
		<property name="EconomicValue" value="10"/>
		<property name="EconomicBundleSize" value="10"/>
		<property name="Group" value="Resources"/>
		<property name="RepairTime" value=".5"/>
		<property name="RepairAmount" value="20"/>
		<property name="CraftingIngredientTime" value=".2"/>
		<property name="SoundPickup" value="scrapiron_grab"/>
		<property name="SoundPlace" value="scrapiron_place"/>
	</item>
	</insertafter>
	
	<insertafter xpath="/items/item[@name='resourceLeather']/property[@name='Material']">
		<property name="CustomIcon" value="leather"/>
	</insertafter>
	
	<insertafter xpath="/items/item[@name='gunRifleT1HuntingRifleParts']/property[@name='Material']">
		<property name="CustomIcon" value="PlasmaRifleParts"/>
	</insertafter>
	
	<insertafter xpath="/items/item[@name='resourceCobblestones']">
	<item name="resourceBricks">
		<property name="HoldType" value="45"/>
		<property name="DescriptionKey" value="BricksDesc"/>
		<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
		<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
		<property name="Material" value="MresourceClayLump"/>
		<property name="CustomIcon" value="palletBricksLoose"/>
		<property name="CustomIconTint" value="9A5B41"/>
		<property name="Weight" value="5"/>
		<property name="Stacknumber" value="1000"/>
		<property name="EconomicValue" value="0"/>
		<property name="Group" value="Resources"/>
		<property name="SoundPickup" value="stone_grab"/>
		<property name="SoundPlace" value="stone_place"/>
	</item>
	</insertafter>
	
