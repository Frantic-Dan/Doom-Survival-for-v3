	<insertafter xpath="/buffs/buff[@name='buffInfectionMain']/effect_group[6]">
		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffStatusInfectionWeakens" operation="set" value="0"/>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffStatusInfectionWeakens" operation="add" value="@infectionCounter"/>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffStatusInfectionWeakens" operation="divide" value="252"/>
