	<buff name="buffC4Explosive" hidden="true" remove_on_death="false">
        <stack_type value="ignore"/>
        <duration value="0"/>
    </buff>
	
	<buff name="buffDismantledAmmo" hidden="true" remove_on_death="false">
        <stack_type value="ignore"/>
        <duration value="0"/>
		<update_rate value=".2"/>
		<effect_group>
			<requirement name="IsOnLadder"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDismantledAmmo"/>
		</effect_group>
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="self" event="TradeDismantledCrossbowAmmo" allow_client_call="true">
				<requirement name="PlayerItemCount" item_name="DismantleCrossbowAmmo" operation="GTE" value="1"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="self" event="TradeDismantledHandgunAmmo" allow_client_call="true">
				<requirement name="PlayerItemCount" item_name="DismantleHandgunAmmo" operation="GTE" value="1"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="self" event="TradeDismantledShotgunAmmo" allow_client_call="true">
				<requirement name="PlayerItemCount" item_name="DismantleShotgunAmmo" operation="GTE" value="1"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="self" event="TradeDismantledChaingunAmmo" allow_client_call="true">
				<requirement name="PlayerItemCount" item_name="DismantleChaingunAmmo" operation="GTE" value="1"/>
			</triggered_effect>
		</effect_group>
		<effect_group>
			<requirements>
				<requirement name="PlayerItemCount" item_name="DismantleCrossbowAmmo" operation="Equals" value="0"/>
				<requirement name="PlayerItemCount" item_name="DismantleHandgunAmmo" operation="Equals" value="0"/>
				<requirement name="PlayerItemCount" item_name="DismantleShotgunAmmo" operation="Equals" value="0"/>
				<requirement name="PlayerItemCount" item_name="DismantleChaingunAmmo" operation="Equals" value="0"/>
			</requirements>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDismantledAmmo"/>
		</effect_group>	
	</buff>

	<buff name="buffArchvileAOEattack">
		<damage_type value="heat"/>
		<stack_type value="ignore"/>
		<duration value="0"/>
		<update_rate value=".5"/>
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" target="selfAOE" range="8" buff="buffArchvileIgnitePlayer">
				<requirement name="EntityTagCompare" target="other" tags="player"/>
				<!-- <requirement name="!HasBuff" target="other" buff="buffInvulnerability"/> -->
			</triggered_effect>
		</effect_group>
	</buff>
	
	<buff name="buffArchvileAOEattackBM">
		<damage_type value="heat"/>
		<stack_type value="ignore"/>
		<duration value="0"/>
		<update_rate value=".5"/>
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" target="selfAOE" range="5" buff="buffArchvileIgnitePlayer">
				<requirement name="EntityTagCompare" target="other" tags="player"/>
				<!-- <requirement name="!HasBuff" target="other" buff="buffInvulnerability"/> -->
			</triggered_effect>
		</effect_group>
	</buff>
		
	<buff name="buffArchvileIgnitePlayer" hidden="true">
		<stack_type value="replace"/>
		<duration value=".75"/>
		<update_rate value=".5"/>
		
		<effect_group>
			<requirement name="!HasBuff" target="self" buff="buffInvulnerability"/>
			<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffIsOnFire"/>
			<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buff2ndDegreeBurn"/>
			<triggered_effect trigger="onSelfBuffRemove" action="RemoveBuff" buff="buffIsOnFire"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddHealth" health="-1"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="player#painsm"/>
		</effect_group>
		
		<effect_group>
			<requirement name="!HasBuff" target="self" buff="buffInvulnerability"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="subtract" value="2">
				<requirement name="CVarCompare" cvar="armourType" operation="Equals" value="0"/>
				<requirement name="CVarCompare" cvar="armourTypeBlue" operation="Equals" value="0"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="subtract" value="1">
				<requirement name="CVarCompare" cvar="armourType" operation="Equals" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Stamina" operation="subtract" value="1">
				<requirement name="CVarCompare" cvar="armourType" operation="Equals" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="subtract" value="0">
				<requirement name="CVarCompare" cvar="armourTypeBlue" operation="Equals" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Stamina" operation="subtract" value="2">
				<requirement name="CVarCompare" cvar="armourTypeBlue" operation="Equals" value="1"/></triggered_effect>
		</effect_group>
	</buff>
	
	<buff name="buffArchvileAOEreviveTrigger" hidden="true">
		<stack_type value="ignore"/>
		<duration value="0"/>
		<!-- <update_rate value="1"/> -->
		<effect_group>
			<!-- <triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="selfAOE" range="1" event="buff_rez" sequence_link="resurrect" allow_client_call="true">
				<requirement name="EntityTagCompare" target="other" tags="revivable"/>
			</triggered_effect> -->
			<triggered_effect trigger="onSelfBuffUpdate" action="CallGameEvent" target="other" event="archvile_revive" allow_client_call="true">
				<requirement name="!IsAlive" target="other"/>
				<requirement name="EntityTagCompare" target="other" tags="revivable"/>
			</triggered_effect>
		</effect_group>
	</buff>

	<buff name="buffEmberAOE" hidden="true">
		<stack_type value="ignore"/>
		<duration value="1"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffEmberAOEEffect"/>
		</effect_group>
	</buff>

	<buff name="buffEmberAOEEffect" name_key="buffCandleAOEEffectName" description_key="buffCandleAOEEffectDesc" icon="ui_game_symbol_campfire">
		<stack_type value="replace"/>
		<duration value="2"/>

		<effect_group>
			<passive_effect name="HypothermalResist" operation="base_add" value="10"/>
			<passive_effect name="HyperthermalResist" operation="base_add" value="-5"/>
		</effect_group>
	</buff>
	
</append>

