	<!-- TRIGGERED_BY: Buffs = buffStatusCheck01 -->
	<!-- Displays a constantly blinking red icon when water is below 2% -->
	<buff name="buffStatusThirsty03" name_key="buffStatusThirsty03Name" description_key="buffStatusThirsty03DescDM" tooltip_key="buffStatusThirsty03TooltipDM" icon="ui_game_symbol_water" icon_color="255,0,0" icon_blink="true">
		<damage_type value="Dehydration"/>
		<damage_source value="Internal"/>
		<stack_type value="ignore"/>
		<update_rate value="1"/>

