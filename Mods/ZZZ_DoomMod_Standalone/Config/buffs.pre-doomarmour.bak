			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffCoffeeBlackstrapDisplay" operation="set" value="@$buffCoffeeBlackstrapDuration"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffCoffeeBlackstrapDisplay" operation="divide" value="@$MetabolismDuration"/>
		</effect_group>

		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffBlackstrapCoffee">
				<requirement name="CVarCompare" cvar="$buffCoffeeBlackstrapDuration" operation="LTE" value="0"/>
			</triggered_effect>

			<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar=".buffCoffeeBlackstrapDisplay,$buffCoffeeBlackstrapDuration"/>
		</effect_group>

		<effect_group>
			<!-- <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffCoffeeDuration" operation="add" value="@$buffCoffeeBSDuration"/> -->

			<!-- <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffCoffeeDuration" operation="set" value="600">
				<requirement name="CVarCompare" cvar="$buffCoffeeDuration" operation="GT" value="600"/>
