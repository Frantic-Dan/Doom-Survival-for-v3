<append xpath="/buffs">
	
	<buff name="buffPlayerDiedAudio" hidden="true" >
        <stack_type value="ignore"/>
        <duration value="1"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffRemove" action="AddBuff" buff="buffPlayerDiedAudioPlay" />
		</effect_group>
    </buff>
	
	<buff name="buffPlayerDiedAudioPlay" hidden="true" >
        <stack_type value="ignore"/>
        <duration value="0"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffRemove" action="PlaySound" sound="player_died" />
		</effect_group>
    </buff>
	
	<buff name="buffNutrientGracePeriod" name_key="NutrientGracePeriod" description_key="NutrientGracePeriodDesc" icon="ui_game_symbol_cookware" icon_color="0,255,0" remove_on_death="false">
		<stack_type value="replace"/>
		<duration value="0"/>
		<display_value value="$buffNutrientGracePeriodDuration"/>
		<display_value_format value="time"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffNutrientGracePeriodDuration" operation="set" value="0"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffNutrientGracePeriodDuration" operation="add" value="4203">
				<requirement name="CVarCompare" cvar="$buffNutrientGracePeriodDuration" operation="Equals" value="0"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffNutrientGracePeriodDuration" operation="add" value="-1"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffNutrientGracePeriodDurationReboot" operation="set" value="@$buffNutrientGracePeriodDuration"/>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffNutrientGracePeriodDuration" operation="set" value="@$buffNutrientGracePeriodDurationReboot"/>
		</effect_group>

		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffNutrientGracePeriod">
				<requirement name="CVarCompare" cvar="$buffNutrientGracePeriodDuration" operation="Equals" value="1"/>
			</triggered_effect>

			<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="$buffNutrientGracePeriodDuration,$buffNutrientGracePeriodDurationReboot"/>
		</effect_group>

		<effect_group>
			<passive_effect name="FoodChangeOT" operation="base_set" value="0"/>
			<passive_effect name="WaterChangeOT" operation="base_set" value="0"/>
			<passive_effect name="HealthChangeOT" operation="base_add" value=".0167"/>
			<passive_effect name="BuffResistance" operation="base_add" value="5" tags="buffInfectionCatch,buffInfectionMain"/>
			<passive_effect name="GeneralDamageResist" operation="base_add" value="0.1"/>
			<triggered_effect trigger="onOtherDamagedSelf" action="ModifyStats" target="self" stat="Stamina" operation="add" value="1">
				<requirement name="CVarCompare" target="self" cvar="armourType" operation="Equals" value="1"/></triggered_effect>
			<triggered_effect trigger="onOtherDamagedSelf" action="ModifyStats" target="self" stat="Stamina" operation="add" value="1">
				<requirement name="CVarCompare" target="self" cvar="armourTypeBlue" operation="Equals" value="1"/></triggered_effect>
		</effect_group>
		<!-- <effect_group>
			<triggered_effect trigger="onOtherDamagedSelf" action="ModifyStats" target="self" stat="Health" operation="subtract" value="-1"/>
			<triggered_effect trigger="onOtherDamagedSelf" action="ModifyStats" target="self" stat="Stamina" operation="subtract" value="-1"/>
		</effect_group> -->
		<!-- onOtherDamagedSelf
		onOtherAttackedSelf -->
		
	</buff>
	
	<buff name="buffAdrenalineRushCheck" hidden="true" remove_on_death="false">
		<stack_type value="ignore"/>
		
		<effect_group>
			<requirement name="ProgressionLevel" progression_name="perkAdrenalineRush" operation="GTE" value="1"/>
			<requirement name="!HasBuff" buff="buffStatusHungry03"/>
			<requirement name="!HasBuff" buff="buffStatusThirsty03"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value=".125">
				<requirement name="StatCompareCurrent" stat="health" operation="LTE" value="50"/></triggered_effect>
		</effect_group>
		
		<effect_group>
			<requirement name="CVarCompare" cvar="perkAdrenalineRush" operation="LTE" value="0"/>
			<requirement name="ProgressionLevel" progression_name="perkAdrenalineRush" operation="Equals" value="4"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffInvulnerability">
				<requirement name="StatCompareCurrent" stat="health" operation="LTE" value="50"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffInvulnerabilityDuration" operation="set" value="5">
				<requirement name="StatCompareCurrent" stat="health" operation="LTE" value="50"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAdrenalineRushCooldown">
				<requirement name="StatCompareCurrent" stat="health" operation="LTE" value="50"/></triggered_effect>
		</effect_group>
		
	</buff>
		
	<buff name="buffAdrenalineRushCooldown" name_key="AdrenalineRushCooldown" description_key="AdrenalineRushCooldownDesc" icon="ui_game_symbol_clock" icon_color="0,255,0" remove_on_death="false">
		<stack_type value="ignore"/>
		<duration value="60"/>
		<display_value value="duration"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="perkAdrenalineRush" operation="set" value="1"/>
			<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="use_powerup" play_in_head="true"/>
			<triggered_effect trigger="onSelfBuffFinish" action="RemoveCVar" cvar="perkAdrenalineRush"/>
			<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="perkAdrenalineRush"/>
		</effect_group>
	</buff>
	
