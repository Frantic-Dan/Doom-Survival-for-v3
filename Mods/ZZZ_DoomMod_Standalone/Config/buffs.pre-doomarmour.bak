			<!-- <triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffBlackStrapCoffee"/> -->

			<!-- <passive_effect name="HealthChangeOT" operation="base_add" value="0.05"> --> <!-- buffCoffee -->
