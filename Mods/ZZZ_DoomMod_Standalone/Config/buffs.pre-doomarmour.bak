		<effect_group>
			<!-- Blinks the display -->
			<passive_effect name="BuffBlink" operation="base_set" value="2" duration="0,3" tags="buffStatusHungry01"/>
			<triggered_effect trigger="onSelfBuffStart" action="RemoveBuff" buff="buffStatusHungry02"/>
