			<!--  <passive_effect name="HealthChangeOT" operation="base_subtract" value=".01248"/> 45 p h, does not work -->
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="subtract" value=".25"/> <!-- 150 p h .0917 -->

