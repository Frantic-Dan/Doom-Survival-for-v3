			<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="Player$Hungry" play_in_head="true">
				<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="0.6"/></triggered_effect>
