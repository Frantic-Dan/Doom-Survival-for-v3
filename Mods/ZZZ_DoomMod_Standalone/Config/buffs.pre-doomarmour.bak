	<!-- *** buffStatusHungry01 -->
	<!-- TRIGGERED_BY: Buffs = buffStatusCheck01 -->
	<!-- Displays an orange icon when food is below 50% -->
	<buff name="buffStatusHungry01" name_key="buffStatusHungry01Name" description_key="buffStatusHungry01DescDM" tooltip_key="buffStatusHungry01TooltipDM" icon="ui_game_symbol_hunger" icon_color="255,128,0">
		<damage_type value="Starvation"/>
		<stack_type value="ignore"/>
