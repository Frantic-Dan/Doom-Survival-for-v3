	<!-- *** buffStatusHungry02 -->
	<!-- TRIGGERED_BY: Buffs = buffStatusCheck01 -->
	<!-- Displays an orange icon when food is below 25% -->
	<buff name="buffStatusHungry02" name_key="buffStatusHungry02Name" description_key="buffStatusHungry02DescDM" tooltip_key="buffStatusHungry02TooltipDM" icon="ui_game_symbol_hunger" icon_color="255,128,0">
