<FranticDan>

<insertafter xpath="/gameevents/action_sequence[@name='game_first_spawn']/action[@class='Delay']">
		<!-- <action class="Delay">
			<property name="time" value="1" />
			<property name="phase" value="2" />
		</action> -->

		<action class="SetItemSlots">
				<property name="items_location" value="Equipment" />
				<property name="items" value="armorNomadHelmet,armorNomadOutfit,armorNomadGloves,armorNomadBoots" />
				<property name="item_counts" value="1-1,1-1,1-1,1-1" />
		</action>
		
		<action class="AddItems">
			<property name="added_items" value="drugHerbalAntibiotics,StoneArrowDM,9mmBulletDM,9mmBulletDM,InvulnerabilityPowerup,armourSecurityGreenPowerUp" />
			<property name="added_item_counts" value="1,100,100,100,1,1" />
		</action>
		<action class="AddBuff">
			<property name="buff_name" value="buffNutrientGracePeriod" />
		</action>
		<action class="AddBuff">
			<property name="buff_name" value="buffFirstSpawnArmour" />
		</action>
		<action class="AddSkillPoints">
			<property name="skill_points" value="{sandbox.StarterSkillPoints}" />
		</action>
</insertafter>

