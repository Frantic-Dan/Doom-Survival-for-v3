<configs>
	<!-- Pre-3.3 storage is a fixed grid. 3.3 scrolls, so the same slot count is 8 wide. -->
	<conditional>
		<if cond="game_version() &lt; version(1,3,30)">
			<set xpath="/windows/window[@name='windowBagStorage']/grid[@name='queue']/@rows">15</set>
			<set xpath="/windows/window[@name='windowBagStorage']/grid[@name='queue']/@cols">15</set>
		</if>
		<else>
			<set xpath="/windows/window[@name='windowBagStorage']/rect[@name='content']/scrollview/grid[@name='queue']/@cols">8</set>
			<set xpath="/windows/window[@name='windowBagStorage']/rect[@name='content']/scrollview/grid[@name='queue']/@rows">29</set>
		</else>
	</conditional>
</configs>